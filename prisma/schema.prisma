// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Feedback {
  id        Int      @id @default(autoincrement())
  assignmentId String
  clientName String
  clientPhone String
  hasBodyguard Boolean
  hasCar Boolean
  salesPersonName String?
  servicedate DateTime
  alreadySubmitted Boolean @default(false)
  submissionDate DateTime?
  status STATUS @default(NEW)
  token String @unique

  // 1-5 rating for each category
  overallExperience Int?
  VehicleCondition Int?
  ChauffeurProfessionalism Int?
  BodyguardProfessionalism Int?
  SafetyAndSecurity Int?
  CoordinationAndCommunication Int?
  comments String?
  createdAt DateTime @default(now())
}

// Status can be "new", "reviewed", "actioned"

enum STATUS {
  NEW
  REVIEWED
  ACTIONED
}